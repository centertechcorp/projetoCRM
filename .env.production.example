# Copie para .env.production (NÃO vai pro Git) e preencha tudo que está marcado TROQUE.
# Gere a APP_KEY com:  docker compose --env-file .env.production -f docker-compose.prod.yml run --rm app php artisan key:generate --show

APP_NAME="CENTER TECH CRM"
APP_ENV=production
APP_KEY=TROQUE
APP_DEBUG=false
APP_URL=https://crm.seudominio.com.br
# Domínio público: o Caddy emite o certificado HTTPS sozinho (a porta 80 e a 443 precisam estar liberadas).
SERVER_NAME=crm.seudominio.com.br

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Banco — escolha UM bloco (o scripts/deploy.sh lê DB_CONNECTION/DB_HOST e sobe o perfil certo).
#
# (A) MariaDB do servidor do dev (externo; nada de banco sobe no compose). Peça ao dev: host, porta,
#     um banco vazio "crm", usuário e senha com todos os privilégios nesse banco.
DB_CONNECTION=mariadb
DB_HOST=TROQUE
DB_PORT=3306
DB_DATABASE=crm
DB_USERNAME=crm
DB_PASSWORD=TROQUE
#
# (B) MariaDB no próprio compose: DB_CONNECTION=mariadb, DB_HOST=mariadb, e defina DB_ROOT_PASSWORD.
# DB_ROOT_PASSWORD=TROQUE
#
# (C) PostgreSQL no próprio compose: DB_CONNECTION=pgsql, DB_HOST=pgsql, DB_PORT=5432.

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
# Mídia baixada do WAHA fica no volume app-storage (persistente). Pra usar bucket S3: FILESYSTEM_DISK=s3 + AWS_*.
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# WAHA — escolha UM modo.
#
# (A) bundled: o pacote sobe os dois WAHA (CENTER e GENIUS) junto; o CRM fala com eles pela rede
#     interna do Docker. Tudo é gerado por ./scripts/gen-secrets.sh.
# (B) external: usa um WAHA que já existe (ex.: o do servidor do dev). Preencha as URLs, as chaves
#     e o NOME DAS SESSÕES de lá, e configure o webhook de cada sessão apontando para o CRM
#     (rode `php artisan whatsapp:waha:check`: ele confere tudo e imprime o webhook esperado).
#     WAHA Core = 1 sessão por instância: CENTER e GENIUS precisam de 2 instâncias (ou WAHA Plus).
WAHA_MODE=bundled
WAHA_CENTER_BASE_URL=http://waha-center:3000
WAHA_GENIUS_BASE_URL=http://waha-genius:3000
WAHA_CENTER_SESSION=CENTER
WAHA_GENIUS_SESSION=GENIUS
WAHA_CENTER_API_KEY=TROQUE
WAHA_GENIUS_API_KEY=TROQUE
# Obrigatória em produção: sem ela o webhook recusa tudo (401). No modo external, é a mesma
# chave (hmac.key) que o webhook de cada sessão do WAHA precisa ter.
WAHA_WEBHOOK_HMAC_KEY=TROQUE
# Só no modo bundled (login do painel dos WAHA do pacote):
WAHA_DASHBOARD_USERNAME=admin
WAHA_CENTER_DASHBOARD_PASSWORD=TROQUE
WAHA_GENIUS_DASHBOARD_PASSWORD=TROQUE
WAHA_ALERT_PHONES=

# Banco do fornecedor (Mix Atacado) — só leitura, preço/estoque de peças. Deixe vazio se não usar.
MIX_ATACADO_DB_HOST=
MIX_ATACADO_DB_PORT=3306
MIX_ATACADO_DB_DATABASE=
MIX_ATACADO_DB_USERNAME=
MIX_ATACADO_DB_PASSWORD=

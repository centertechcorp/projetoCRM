{
    "manifest_version": 3,
    "name": "WhatsApp Logger (CRM)",
    "version": "0.1.0",
    "description": "Envia cada mensagem do WhatsApp Web ao daemon local (php artisan whatsapp:listen).",
    "permissions": ["storage", "alarms"],
    "host_permissions": [
        "https://web.whatsapp.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://web.whatsapp.com/*"],
            "js": ["content-main.js"],
            "world": "MAIN",
            "run_at": "document_start"
        },
        {
            "matches": ["https://web.whatsapp.com/*"],
            "js": ["content-bridge.js"],
            "run_at": "document_start"
        }
    ],
    "options_page": "options.html",
    "action": {
        "default_title": "WhatsApp Logger: opções"
    }
}
